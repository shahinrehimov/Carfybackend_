APP_NAME=Carfy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Baku
APP_URL=http://api.carfy.test
FRONTEND_URL=https://carfy.vercel.app
COMPANY_FRONTEND_URL=https://carfy-company.vercel.app
APP_OTP_DEBUG_MODE=false

LOGGER_ENABLED=true
LOGGER_SQL_DEBUG=false

LANG_CACHE_ENABLE=true
LANG_SET_DEFAULT_ENABLE=true
LANG_HAS_USER_LANG=false
LANG_DEFAULT_LANG=az
LANG_CACHE_LANGUAGE_KEY=cache_languages
LANG_CACHE_TRANSLATIONS_KEY=cache_translations

APP_LOCALE=az
APP_FALLBACK_LOCALE=az
APP_FAKER_LOCALE=az_AZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=carfy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Search (Laravel Scout + Elasticsearch)
SCOUT_DRIVER=elastic
SCOUT_QUEUE=true
SCOUT_PREFIX=carfy_
ELASTIC_HOST=localhost:9200
# Production node auth/TLS (leave unset for a local node with security disabled)
# ELASTIC_API_KEY=
# ELASTIC_USERNAME=
# ELASTIC_PASSWORD=
# ELASTIC_CA_BUNDLE=
# ELASTIC_SSL_VERIFICATION=true
# Replica count for the search index: 0 for single-node dev, >= 1 in production
ELASTIC_INDEX_REPLICAS=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_SUPERADMIN_USERNAME=
APP_SUPERADMIN_EMAIL=
APP_SUPERADMIN_NAME=
APP_SUPERADMIN_SURNAME=
APP_SUPERADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

SLIDER_CACHE_DURATION=300
SLIDER_MAX_LAYERS=20
SLIDER_MAX_SLIDES=50
SLIDER_ENABLE_WEBP=true
SLIDER_LAZY_LOADING=true

C1_URL=

# Payment System Configuration
PAYMENT_LOGGING=true
PAYMENT_AUTO_DISCOVERY=false
PAYMENT_CACHE_ENABLED=false
PAYMENT_DB_CONFIG=false

# Cash Payment
CASH_PAYMENT_ENABLED=true
CASH_MIN_AMOUNT=100
CASH_MAX_AMOUNT=1000000

# Bank 1
BANK1_ENABLED=false
BANK1_API_URL=https://api.bank1.az/payments
BANK1_VERIFY_URL=https://api.bank1.az/verify
BANK1_MERCHANT_ID=your_merchant_id
BANK1_SECRET_KEY=your_secret_key
BANK1_WEBHOOK_SECRET=your_webhook_secret
BANK1_MIN_AMOUNT=50
BANK1_MAX_AMOUNT=500000
BANK1_TEST_MODE=false

# Bank 2
BANK2_ENABLED=false
BANK2_API_URL=https://api.bank2.az/payments
BANK2_API_KEY=your_api_key
BANK2_MERCHANT_ID=your_merchant_id
BANK2_MIN_AMOUNT=100
BANK2_MAX_AMOUNT=1000000
BANK2_TEST_MODE=false

# FPay
FPAY_ENABLED=false
FPAY_API_URL=https://payments.fpay.az
FPAY_USERNAME=
FPAY_PASSWORD=
FPAY_SECRET_KEY=
FPAY_MERCHANT_NAME=
FPAY_MIN_AMOUNT=50
FPAY_MAX_AMOUNT=10000000
FPAY_TEST_MODE=false

# Kapital Bank
KAPITALBANK_ENABLED=false
KAPITALBANK_INSTALLMENT_ENABLED=false
KAPITALBANK_API_URL=https://txpgtst.kapitalbank.az/api
KAPITALBANK_HPP_URL=https://txpgtst.kapitalbank.az/flex
KAPITALBANK_USERNAME=
KAPITALBANK_PASSWORD=
KAPITALBANK_LANGUAGE=az
KAPITALBANK_TITLE=Carfy
KAPITALBANK_MIN_AMOUNT=50
KAPITALBANK_MAX_AMOUNT=10000000
KAPITALBANK_TEST_MODE=true

# SMS Configuration
SMS_PROVIDER=pg365
SMS_DEBUG_MODE=false

# PG365 (Posta Güvercini)
SMS_PG365_BASE_URL=https://api.poctgoyercini.com
SMS_PG365_PUBLIC_KEY=
SMS_PG365_PRIVATE_KEY=
SMS_PG365_ORIGINATOR=

# Firebase Cloud Messaging (FCM)
# Service account JSON faylini storage/app/ qovluguna yerlesdirin (gitignored)
FIREBASE_CREDENTIALS=/absolute/path/to/storage/app/your-firebase-adminsdk.json

# Referral test seeder (mock data) — keep disabled in prod
REFERRAL_TEST_SEED_ENABLED=false
REFERRAL_TEST_SEED_KEY=
